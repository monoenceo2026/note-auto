# =============================================================================
# note-auto  環境変数サンプル
# =============================================================================
# 使い方:
#   1) このファイルを scripts/.env にコピー（.env は .gitignore 済み＝コミットされません）
#   2) 各値を実際のものに書き換え
#   3) 本番（Claudeルーチンの環境）では、リモート環境の「環境変数 / シークレット」に
#      同じキー名で登録してください（.env ファイルは本番では使いません）。
#
# ⚠️ ここに入れる値（特に OPENAI_API_KEY と NOTE_SESSION_COOKIE）は機密です。
#    絶対にリポジトリにコミットしないでください。
# =============================================================================

# --- アイキャッチ画像（OpenAI gpt-image-1）--- 必須 -----------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 画像モデル（通常は変更不要）
OPENAI_IMAGE_MODEL=gpt-image-1
# 画像品質: high / medium / low。テキストを画像内に描く（一発生成）ため、文字の再現性重視なら high 推奨。
OPENAI_IMAGE_QUALITY=high

# --- note 自動公開（非公式API・完全自動公開=C を選んだ場合のみ）--- 任意 ---------
# ⚠️ note には公式の投稿APIが無く、以下はブラウザのログインセッションを使う
#    「非公式」な方法です。note の仕様変更で停止することがあり、規約上のリスクも
#    ゼロではありません（詳細は SETUP.md / OPERATIONS.md）。
#
# NOTE_SESSION_COOKIE には、ログイン済みブラウザの Cookie 文字列を入れます。
# 最低限 `_note_session_v5` を含めてください（取得方法は SETUP.md 参照）。
# 例) NOTE_SESSION_COOKIE="_note_session_v5=xxxxx; note_gql_auth_token=yyyyy"
NOTE_SESSION_COOKIE=
# あなたのnoteユーザー名（URLの @ の後ろ。例: monoen_co_jp）
NOTE_USERNAME=monoen_co_jp

# --- パイプラインの動作モード -------------------------------------------------
# 既定（未設定時）は PUBLISH_MODE=auto / DRY_RUN=0。
#   → NOTE_SESSION_COOKIE を入れれば「QA合格記事を note に自動公開」します。
#   → Cookie 未設定なら自動で package（note未投稿の安全動作）にfallbackします。
# PUBLISH_MODE:
#   auto   = QA合格なら note に自動公開（あなたの選択= C・既定）
#   draft  = note に「下書き」まで作成し、公開はしない
#   package= note へは触らず、ローカルに完成パッケージのみ生成（最も安全）
PUBLISH_MODE=auto

# DRY_RUN=1 のときは note へのAPI呼び出しを実際には行わず、送信内容だけログ出力（テスト用）。
# まず数日 DRY_RUN=1 で試し、問題なければ 0（本番公開）に。
DRY_RUN=0

# 公開予定時刻（記事メタに使用。JST）
PUBLISH_TIME_JST=08:00

# 1回の生成で許容する画像コスト上限の目安（USD、超えたら画像をスキップして警告）
IMAGE_COST_CEILING_USD=0.30
